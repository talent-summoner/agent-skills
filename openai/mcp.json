{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "talent-summoner": {
      "type": "streamable-http",
      "url": "https://talentsummoner.com/api/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "REPLACE_WITH_CHATGPT_CLIENT_ID",
              "tokenEndpointAuthMethod": "client_secret_post"
            },
            "baseScopes": [
              "openid",
              "email",
              "offline_access"
            ]
          }
        }
      }
    }
  }
}
